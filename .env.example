# Local development defaults
PORT=5000
# Optional separate API port when the host uses PORT for the frontend.
# API_PORT=5000
# Optional frontend port (defaults to 5173).
# VITE_PORT=5173
# Optional path for the local SQLite database (defaults to data/all-about-iot.sqlite).
# DATABASE_PATH=data/all-about-iot.sqlite
# Set HOST=0.0.0.0 when running inside a container or behind a public proxy.
# HOST=127.0.0.1
# Set comma-separated browser origins only when the frontend is hosted separately.
# CORS_ORIGIN=https://example.com
# LOG_LEVEL=info
